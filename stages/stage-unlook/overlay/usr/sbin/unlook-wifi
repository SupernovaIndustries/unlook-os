#!/bin/sh
# unlook-wifi -- the unit's Wi-Fi client setup: the only tool that writes it.
#
#   unlook-wifi status [--kv]   mode, connection, address, last result
#   unlook-wifi list            networks seen by the last scan (signal<TAB>security<TAB>ssid)
#   unlook-wifi scan            rescan (not possible while the hotspot holds the radio: keeps the list)
#   unlook-wifi set             read "<ssid>\n<password>\n" on stdin (empty password = open
#                               network), save it and switch to it in the background;
#                               on failure the previous setup and the hotspot come back
#   unlook-wifi forget          drop every saved Wi-Fi network, back to the hotspot
#   unlook-wifi boot | watch | apply    (systemd units, internal)
#
# Network modes of the SDK daemon (net_mode, written to /run/unlook/net.env):
#   no Wi-Fi saved  -> ap   hotspot always on (setup page + phone app)
#   Wi-Fi saved     -> ble  the unit joins the Wi-Fi; the app can still raise the
#                           hotspot over BLE (the radio is single: the Wi-Fi drops
#                           while the phone uses it and comes back afterwards)
# A saved Wi-Fi that does not connect within NET_LAN_FALLBACK_S puts the
# hotspot back (never unreachable). Networks live on the data partition
# (/etc/unlook/network, restored into NetworkManager by unlook-identity), so they
# survive OS updates. Owner decision: docs/OS.md §9.
set -eu
UOS_TAG=unlook-wifi
# shellcheck source=../lib/unlook-os/common.sh
. "${UNLOOK_OS_LIBDIR:-/usr/lib/unlook-os}/common.sh"

IFACE="$(uos_conf NET_AP_IFACE wlan0 '[A-Za-z0-9_.-]{1,15}')"
AP_ADDRESS="$(uos_conf NET_AP_ADDRESS 10.42.0.1/24 '([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}')"
FALLBACK_S="$(uos_conf NET_LAN_FALLBACK_S 120 '[0-9]{2,4}')"
STORE="$UOS_ROOT/etc/unlook/network"
NMDIR="$UOS_ROOT/etc/NetworkManager/system-connections"
RUN="$UOS_ROOT/run/unlook/wifi"
NET_ENV="$UOS_ROOT/run/unlook/net.env"
CON=unlook-wifi
# The SDK's hotspot connection (never created or edited here).
AP_CON=unlook-ap
MAX_LIST=40

install -d -m 0755 "$UOS_ROOT/run/unlook"
install -d -m 0700 "$RUN"

# ---- state --------------------------------------------------------------------------

# status_set <state> <ssid> <error>
status_set() {
    _t="$RUN/status.new"
    {
        echo "state=$1"
        echo "ssid=$2"
        echo "error=$3"
        echo "updated=$(date +%s)"
    } > "$_t"
    mv -f "$_t" "$RUN/status"
}

status_get() { sed -n "s/^$1=//p" "$RUN/status" 2>/dev/null | head -n 1; }

# mode_set ap|ble -- the daemon reads it at its next (re)start.
mode_set() {
    _t="$NET_ENV.new"
    printf 'UNLOOK_NET_MODE=%s\nUNLOOK_AP_IFACE=%s\nUNLOOK_AP_ADDRESS=%s\n' "$1" "$IFACE" "$AP_ADDRESS" > "$_t"
    chmod 0644 "$_t"
    mv -f "$_t" "$NET_ENV"
}

mode_get() { sed -n 's/^UNLOOK_NET_MODE=//p' "$NET_ENV" 2>/dev/null | head -n 1; }

# A saved client network: a keyfile of type wifi that is not an access point.
is_client_keyfile() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    grep -q '^type=wifi$' "$1" || grep -q '^type=802-11-wireless$' "$1" || return 1
    ! grep -q '^mode=ap$' "$1"
}

has_client() {
    for _f in "$STORE"/*.nmconnection; do
        is_client_keyfile "$_f" && return 0
    done
    return 1
}

lock() {
    exec 9> "$RUN/lock"
    flock -w "${1:-0}" 9 || uos_die "another Wi-Fi change is in progress"
}

daemon_restart() {
    systemctl restart unlook-stream.service 2>/dev/null ||
        uos_log warning "could not restart unlook-stream"
}

# ---- scan ---------------------------------------------------------------------------

# nmcli -t separates fields with ':' and escapes ':' and '\' inside values with
# '\'. Byte semantics (C locale): the SSID limit is 32 bytes.
scan_parse() {
    LC_ALL=C awk '
    {
        n = 0; f[0] = ""; f[1] = ""; f[2] = ""; esc = 0
        for (i = 1; i <= length($0); i++) {
            c = substr($0, i, 1)
            if (esc) { f[n] = f[n] c; esc = 0; continue }
            if (c == "\\") { esc = 1; continue }
            if (c == ":" && n < 2) { n++; continue }
            f[n] = f[n] c
        }
        sig = f[0]; sec = f[1]; ssid = f[2]
        if (ssid == "" || sig !~ /^[0-9]+$/ || ssid ~ /[[:cntrl:]]/ || length(ssid) > 32) next
        if (sec == "" || sec == "--") sec = "open"
        if (!(ssid in best) || sig + 0 > best[ssid] + 0) { best[ssid] = sig; secs[ssid] = sec }
    }
    END { for (s in best) printf "%s\t%s\t%s\n", best[s], secs[s], s }' |
        LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k3,3 | head -n "$MAX_LIST"
}

# Radio free (no hotspot) -> fresh list; otherwise keep the previous one.
scan() {
    command -v rfkill >/dev/null 2>&1 && rfkill unblock wlan 2>/dev/null || true
    nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
    sleep "${UNLOOK_WIFI_SCAN_WAIT:-4}"
    _new="$RUN/scan.new"
    nmcli -t -f SIGNAL,SECURITY,SSID device wifi list ifname "$IFACE" 2>/dev/null | scan_parse > "$_new" || true
    if [ -s "$_new" ]; then
        mv -f "$_new" "$RUN/scan.tsv"
    else
        rm -f "$_new"
        uos_log info "Wi-Fi scan returned nothing (radio busy?): previous list kept"
    fi
}

security_of() {
    awk -F '\t' -v s="$1" '$3 == s { print $2; exit }' "$RUN/scan.tsv" 2>/dev/null
}

# ---- validation + keyfile -------------------------------------------------------------

# SSID: 1..32 bytes, no control characters (UTF-8 allowed).
valid_ssid() {
    _n="$(printf '%s' "$1" | wc -c | tr -d ' ')"
    [ "$_n" -ge 1 ] && [ "$_n" -le 32 ] || return 1
    ! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'
}

# Password: empty (open), 8..63 printable ASCII, or 64 hex digits.
valid_psk() {
    [ -z "$1" ] && return 0
    printf '%s\n' "$1" | LC_ALL=C grep -Eq '^([ -~]{8,63}|[0-9A-Fa-f]{64})$'
}

# The SSID is written as a byte list (no escaping ambiguity); in the password
# GKeyFile needs '\' and spaces escaped.
write_keyfile() {
    _ssid="$1"
    _psk="$2"
    _km="$3"
    _bytes="$(printf '%s' "$_ssid" | od -An -v -tu1 | tr -s ' \n' '  ' | sed 's/^ //; s/ $//; s/ /;/g');"
    _uuid="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || od -An -N16 -tx1 /dev/urandom | tr -d ' \n' |
        sed 's/^\(.\{8\}\)\(.\{4\}\).\(.\{3\}\).\(.\{3\}\)\(.\{12\}\).*/\1-\2-4\3-8\4-\5/')"
    printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\ninterface-name=%s\nautoconnect=true\nautoconnect-priority=10\n\n' \
        "$CON" "$_uuid" "$IFACE"
    printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$_bytes"
    if [ "$_km" != none ]; then
        _esc="$(printf '%s' "$_psk" | sed -e 's/\\/\\\\/g' -e 's/ /\\s/g')"
        printf '[wifi-security]\nkey-mgmt=%s\npsk=%s\n\n' "$_km" "$_esc"
    fi
    printf '[ipv4]\nmethod=auto\n\n[ipv6]\naddr-gen-mode=stable-privacy\nmethod=auto\n'
}

# ---- apply: switch to the saved network, or roll back -----------------------------------

connected_to() {
    nmcli -t -f GENERAL.CONNECTION device show "$IFACE" 2>/dev/null | sed -n 's/^GENERAL.CONNECTION://p' | head -n 1
}

address() {
    nmcli -t -f IP4.ADDRESS device show "$IFACE" 2>/dev/null | sed -n 's/^IP4.ADDRESS\[1\]://p' | head -n 1 | cut -d/ -f1
}

do_apply() {
    lock 30
    ssid="$(status_get ssid)"
    status_set connecting "$ssid" -
    # Let the setup page deliver its answer before the hotspot goes.
    sleep "${UNLOOK_WIFI_APPLY_DELAY:-3}"
    mode_set ble
    daemon_restart
    nmcli connection down "$AP_CON" >/dev/null 2>&1 || true
    nmcli connection reload >/dev/null 2>&1 || true
    if nmcli --wait 45 connection up "$CON" ifname "$IFACE" >/dev/null 2>&1; then
        rm -f "$STORE/$CON.nmconnection.bak"
        status_set connected "$ssid" -
        uos_log notice "Wi-Fi '$ssid' connected ($(address))"
        return 0
    fi
    uos_log warning "Wi-Fi '$ssid' did not connect: previous setup restored"
    if [ -f "$STORE/$CON.nmconnection.bak" ]; then
        mv -f "$STORE/$CON.nmconnection.bak" "$STORE/$CON.nmconnection"
        install -m 0600 "$STORE/$CON.nmconnection" "$NMDIR/$CON.nmconnection"
    else
        rm -f "$STORE/$CON.nmconnection" "$NMDIR/$CON.nmconnection"
    fi
    nmcli connection reload >/dev/null 2>&1 || true
    if has_client && nmcli --wait 45 connection up "$CON" ifname "$IFACE" >/dev/null 2>&1; then
        status_set failed "$ssid" "connessione non riuscita: ripristinata la rete precedente"
        return 1
    fi
    scan
    mode_set ap
    daemon_restart
    status_set failed "$ssid" "connessione non riuscita (password o segnale): hotspot riattivato"
    return 1
}

do_set() {
    IFS= read -r ssid || true
    IFS= read -r psk || true
    ssid="$(printf '%s' "$ssid" | tr -d '\r')"
    psk="$(printf '%s' "$psk" | tr -d '\r')"
    valid_ssid "$ssid" || uos_die "invalid network name (1-32 bytes, no control characters)"
    valid_psk "$psk" || uos_die "invalid password (8-63 characters, or 64 hex digits)"
    if [ -z "$psk" ]; then
        km=none
    else
        case "$(security_of "$ssid")" in
            *WPA3*) case "$(security_of "$ssid")" in *WPA2* | *WPA1*) km=wpa-psk ;; *) km=sae ;; esac ;;
            *) km=wpa-psk ;;
        esac
    fi
    lock 5
    umask 077
    install -d -m 0700 "$STORE"
    install -d -m 0700 "$NMDIR"
    if [ -f "$STORE/$CON.nmconnection" ]; then
        cp -p "$STORE/$CON.nmconnection" "$STORE/$CON.nmconnection.bak"
    fi
    write_keyfile "$ssid" "$psk" "$km" > "$STORE/$CON.nmconnection.new"
    chmod 0600 "$STORE/$CON.nmconnection.new"
    mv -f "$STORE/$CON.nmconnection.new" "$STORE/$CON.nmconnection"
    install -m 0600 "$STORE/$CON.nmconnection" "$NMDIR/$CON.nmconnection"
    status_set pending "$ssid" -
    exec 9>&-
    uos_log notice "Wi-Fi '$ssid' saved; switching in the background"
    # Out of this process (the setup page's sandbox) and of its lifetime.
    systemd-run --no-block --collect --unit="unlook-wifi-apply-$(date +%s)" \
        --description="Unlook Wi-Fi switch" /usr/sbin/unlook-wifi apply >/dev/null
}

do_forget() {
    lock 30
    for f in "$STORE"/*.nmconnection "$STORE"/*.nmconnection.bak; do
        is_client_keyfile "$f" || continue
        b="$(basename "$f")"
        rm -f "$f" "$NMDIR/$b"
    done
    nmcli connection reload >/dev/null 2>&1 || true
    nmcli connection down "$CON" >/dev/null 2>&1 || true
    nmcli connection delete "$CON" >/dev/null 2>&1 || true
    scan
    mode_set ap
    daemon_restart
    status_set ap - -
    uos_log notice "saved Wi-Fi networks removed: hotspot on"
}

# ---- boot / watch ---------------------------------------------------------------------

do_boot() {
    command -v rfkill >/dev/null 2>&1 && rfkill unblock wlan 2>/dev/null || true
    i=0
    while [ "$i" -lt 20 ]; do
        nmcli -t -f DEVICE device 2>/dev/null | grep -qx "$IFACE" && break
        sleep 1
        i=$((i + 1))
    done
    if has_client; then
        mode_set ble
        status_set joining - -
    else
        # Before the daemon raises the hotspot: the radio is still free to scan.
        scan
        mode_set ap
        status_set ap - -
    fi
    uos_log info "network mode $(mode_get)"
}

do_watch() {
    if [ "$(mode_get)" = ap ]; then
        # The SDK does not retry a failed hotspot bring-up: one daemon restart.
        i=0
        while [ "$i" -lt 60 ]; do
            [ "$(connected_to)" = "$AP_CON" ] && exit 0
            sleep "${UNLOOK_WIFI_POLL_S:-5}"
            i=$((i + 5))
        done
        uos_log warning "hotspot not up after 60s: restarting unlook-stream once"
        daemon_restart
        exit 0
    fi
    [ "$(mode_get)" = ble ] || exit 0
    i=0
    while [ "$i" -lt "$FALLBACK_S" ]; do
        c="$(connected_to)"
        case "$c" in
            '' | --) ;;
            "$AP_CON") exit 0 ;; # a phone raised the hotspot over BLE
            *)
                status_set connected "$c" -
                uos_log info "Wi-Fi '$c' connected ($(address))"
                exit 0 ;;
        esac
        sleep "${UNLOOK_WIFI_POLL_S:-5}"
        i=$((i + 5))
    done
    lock 30
    uos_log warning "no Wi-Fi connection after ${FALLBACK_S}s: hotspot on (saved networks kept)"
    scan
    mode_set ap
    daemon_restart
    status_set fallback - "Wi-Fi salvato non raggiungibile: hotspot riattivato"
}

do_status() {
    mode="$(mode_get)"
    con="$(connected_to)"
    ip="$(address)"
    if [ "${1:-}" = --kv ]; then
        printf 'mode=%s\nconnection=%s\naddress=%s\nstate=%s\nssid=%s\nerror=%s\n' \
            "${mode:-unknown}" "${con:---}" "${ip:--}" "$(status_get state)" "$(status_get ssid)" "$(status_get error)"
        return 0
    fi
    echo "mode:       ${mode:-unknown} ($([ "$mode" = ap ] && echo 'hotspot on' || echo 'Wi-Fi client'))"
    echo "connection: ${con:---}"
    echo "address:    ${ip:--}"
    echo "last:       $(status_get state) $(status_get ssid) $(status_get error)"
}

case "${1:-}" in
    status) do_status "${2:-}" ;;
    list) cat "$RUN/scan.tsv" 2>/dev/null || true ;;
    scan | set | forget | boot | watch | apply)
        [ -n "$UOS_ROOT" ] || [ "$(id -u)" -eq 0 ] || uos_die "must run as root"
        case "$1" in
            scan) lock 5; scan; cat "$RUN/scan.tsv" 2>/dev/null || true ;;
            set) do_set ;;
            forget) do_forget ;;
            boot) do_boot ;;
            watch) do_watch ;;
            apply) do_apply ;;
        esac
        ;;
    *)
        sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
        exit 64
        ;;
esac
