#!/bin/sh
# unlook-credentials -- how to reach this unit, with its per-unit secrets.
#
#   unlook-credentials              print them (root)
#   unlook-credentials --kv         key=value, for the setup page
#   unlook-credentials write-cfg    (boot) write unlook-credenziali.txt + QR codes on the
#                                   UNLOOKCFG partition (NET_CREDENTIALS_FILE=on), readable
#                                   from a PC -- the same partition Raspberry Pi Imager uses
#
# Secrets (all per unit, none shared across units):
#   SSH admin password   /etc/unlook/credentials/admin-password, made at first boot
#                        when Raspberry Pi Imager set no password; gone once changed
#                        with `unlook-ssh passwd` (then it is known only to who set it)
#   hotspot password     /var/lib/unlook/hotspot.psk, made by the SDK daemon
#   pairing code         unlook_stream --pairing-code (BLE, Android app)
# Owner decision: docs/OS.md §9.
set -eu
UOS_TAG=unlook-credentials
# shellcheck source=../lib/unlook-os/common.sh
. "${UNLOOK_OS_LIBDIR:-/usr/lib/unlook-os}/common.sh"

ETC="$UOS_ROOT/etc/unlook"
VAR="$UOS_ROOT/var/lib/unlook"
AP_ADDRESS="$(uos_conf NET_AP_ADDRESS 10.42.0.1/24 '([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}')"
AP_IP="${AP_ADDRESS%/*}"
PORT="$(uos_conf NET_SETUP_PORT 80 '[0-9]{1,5}')"
CFG_FILE="$(uos_conf NET_CREDENTIALS_FILE on 'on|off')"
MDNS="$(uos_conf NET_MDNS on 'on|off')"
OUT=unlook-credenziali.txt

[ -n "$UOS_ROOT" ] || [ "$(id -u)" -eq 0 ] || uos_die "must run as root"

first_line() { sed -n '1p' "$1" 2>/dev/null | tr -d '\r' || true; }

unit="$(first_line "$ETC/unit-id")"
printf '%s' "$unit" | grep -Eq '^[A-Za-z0-9-]{1,63}$' || unit=""
host="$(first_line "$UOS_ROOT/etc/hostname")"
printf '%s' "$host" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9-]{0,62}$' || host="$unit"
user="$(getent passwd 1000 | cut -d: -f1)"
[ -n "$user" ] || user=@ADMIN_USER@

# SSH password: the first-boot one while unchanged, else say who set it.
password="$(first_line "$ETC/credentials/admin-password")"
printf '%s' "$password" | grep -Eq '^[A-Za-z0-9-]{8,64}$' || password=""
if [ -n "$password" ]; then
    password_note=""
elif [ -s "$ETC/imager/password-hash" ]; then
    password_note="impostata con Raspberry Pi Imager"
elif [ -s "$ETC/credentials/admin-password-hash" ]; then
    password_note="cambiata con unlook-ssh passwd"
else
    password_note="nessuna (solo chiavi SSH)"
fi
ssh_state="off"
[ -f "$ETC/ssh/enabled" ] && ssh_state="on"

# Hotspot: SSID = the SDK's default, Unlook-<unit id digits>; password made by
# the daemon the first time it raises the hotspot.
ssid=""
[ -n "$unit" ] && ssid="Unlook-${unit#UNLK-}"
psk="$(first_line "$VAR/hotspot.psk")"
printf '%s' "$psk" | grep -Eq '^[ -~]{8,63}$' || psk=""

# Pairing code (read from the SDK, only where it is shown).
pairing=""
pairing_read() {
    command -v unlook_stream >/dev/null 2>&1 && [ -s "$VAR/pairing.secret" ] || return 0
    pairing="$(UNLOOK_PROFILE="$ETC/scanner_profile.yaml" unlook_stream "$ETC/scanner_profile.yaml" \
        --pairing-code --machine 2>/dev/null | sed -n '1{/^UNLOOK1:[A-Za-z0-9-]\{1,63\}:[A-Za-z2-7]\{16,64\}$/p;}')" || pairing=""
}

url="http://$AP_IP/"
[ "$PORT" = 80 ] || url="http://$AP_IP:$PORT/"
lan_name="(indirizzo dal router)"
[ "$MDNS" = on ] && [ -n "$host" ] && lan_name="$host.local"

# The cfg partition also carries autoboot.txt (A/B commit, unlook-health /
# unlook-ota): never share their mount point, whose umount could land in the
# middle of a commit. Same device, own mount point, same options.
cred_mount() {
    if [ -n "$UOS_ROOT" ]; then
        CDIR="$UOS_ROOT/cfg"
        mkdir -p "$CDIR"
        return 0
    fi
    CDIR=/run/unlook/cfg-credentials
    install -d -m 0700 "$CDIR"
    mountpoint -q "$CDIR" && return 0
    mount -t vfat -o rw,nodev,nosuid,noexec,sync,umask=0077 /dev/disk/by-partlabel/unlook-cfg "$CDIR"
}

cred_umount() {
    [ -n "$UOS_ROOT" ] && return 0
    sync
    umount "$CDIR" 2>/dev/null || true
}

# WIFI: QR payload; ';' ',' ':' '"' '\' escaped with '\'.
wifi_qr() {
    _e() { printf '%s' "$1" | sed 's/[\\;,:"]/\\&/g'; }
    printf 'WIFI:T:WPA;S:%s;P:%s;;' "$(_e "$ssid")" "$(_e "$psk")"
}

render() {
    psk_text="$psk"
    [ -n "$psk_text" ] || psk_text="(generata alla prima accensione dell hotspot)"
    pw_text="$password"
    [ -n "$pw_text" ] || pw_text="$password_note"
    cat << EOF
Unlook -- credenziali di questa unita (${unit:-?})
Tienile riservate: danno accesso completo allo scanner.

HOTSPOT (primo avvio, e quando il Wi-Fi salvato non e raggiungibile)
  Rete:      ${ssid:-?}
  Password:  $psk_text
  Setup:     $url   (scegli il Wi-Fi dell ufficio)

SSH (attivo: $ssh_state)
  Utente:    $user
  Password:  $pw_text
  Hotspot:   ssh $user@$AP_IP
  In rete:   ssh $user@$lan_name
  Cambiala:  sudo unlook-ssh passwd

APP ANDROID (Bluetooth)
  Codice di pairing:  ${pairing:-(non disponibile)}
EOF
}

case "${1:-}" in
    '') pairing_read; render ;;
    --kv)
        printf 'unit=%s\nhost=%s\nlan_name=%s\nuser=%s\npassword=%s\npassword_note=%s\nssh=%s\nssid=%s\nsetup_url=%s\n' \
            "$unit" "$host" "$lan_name" "$user" "$password" "$password_note" "$ssh_state" "$ssid" "$url"
        ;;
    write-cfg)
        [ "$CFG_FILE" = on ] || exit 0
        pairing_read
        # The hotspot password appears when the daemon first raises the hotspot.
        i=0
        while [ -z "$psk" ] && [ "$i" -lt "${UNLOOK_CRED_WAIT_S:-90}" ] && systemctl is-active --quiet unlook-stream.service 2>/dev/null; do
            sleep 3
            i=$((i + 3))
            psk="$(first_line "$VAR/hotspot.psk")"
            printf '%s' "$psk" | grep -Eq '^[ -~]{8,63}$' || psk=""
        done
        umask 077
        install -d -m 0700 "$UOS_ROOT/run/unlook"
        new="$UOS_ROOT/run/unlook/credentials.txt"
        render | sed 's/$/\r/' > "$new"
        cred_mount || uos_die "cannot mount the cfg partition"
        if ! cmp -s "$new" "$CDIR/$OUT" 2>/dev/null; then
            cp "$new" "$CDIR/$OUT.new"
            mv -f "$CDIR/$OUT.new" "$CDIR/$OUT"
            if command -v qrencode >/dev/null 2>&1; then
                rm -f "$CDIR/unlook-qr-wifi.png" "$CDIR/unlook-qr-pairing.png"
                if [ -n "$ssid" ] && [ -n "$psk" ]; then
                    wifi_qr | qrencode -o "$CDIR/unlook-qr-wifi.png" -s 8 -l M -r /dev/stdin 2>/dev/null || true
                fi
                if [ -n "$pairing" ]; then
                    printf '%s' "$pairing" | qrencode -o "$CDIR/unlook-qr-pairing.png" -s 8 -l M -r /dev/stdin 2>/dev/null || true
                fi
            fi
            uos_log notice "credentials written to the UNLOOKCFG partition ($OUT)"
        fi
        cred_umount
        rm -f "$new"
        ;;
    *)
        sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
        exit 64
        ;;
esac
