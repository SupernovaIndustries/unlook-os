[Unit]
Description=Unlook credentials file on the UNLOOKCFG partition (readable from a PC)
Documentation=file:/usr/share/doc/unlook-os/OS.md
RequiresMountsFor=/etc/unlook /var/lib/unlook
# After the A/B commit decision: unlook-health writes autoboot.txt on the same
# partition (own mount points anyway, see unlook-credentials).
After=unlook-stream.service unlook-ssh.service unlook-identity.service unlook-health.service

[Service]
Type=simple
ExecStart=/usr/sbin/unlook-credentials write-cfg

[Install]
WantedBy=multi-user.target
