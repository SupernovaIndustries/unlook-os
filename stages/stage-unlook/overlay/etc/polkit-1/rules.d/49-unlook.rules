// Unlook OS: what the scanner daemon may do when it runs as the service user
// (SDK_DAEMON_USER=@SERVICE_USER@). Nothing else is granted; every other
// request falls through to the default policy (denied for a system user).
polkit.addRule(function (action, subject) {
    if (subject.user !== "@SERVICE_USER@") {
        return polkit.Result.NOT_HANDLED;
    }
    // Hotspot on demand and the USB/LAN connections (nmcli).
    var nm = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.own",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.share.protected",
        "org.freedesktop.NetworkManager.wifi.share.open",
        "org.freedesktop.NetworkManager.wifi.scan"
    ];
    if (nm.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    // ota_check / ota_apply: start exactly these units, nothing else.
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "start") {
        var unit = action.lookup("unit");
        if (unit === "unlook-ota-check.service" ||
            unit === "unlook-ota-apply@sdk.service" ||
            unit === "unlook-ota-apply@os.service") {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
